<Window x:Class="GameShelf.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:GameShelf.Windows" Title="游戏库">
 <Grid x:Name="Root" RequestedTheme="Light" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid x:Name="LoginPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="0.38*"/><ColumnDefinition Width="0.62*"/></Grid.ColumnDefinitions>
   <Grid><Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#1F336E" Offset="0"/><GradientStop Color="#3D5CB0" Offset="1"/></LinearGradientBrush></Grid.Background>
    <Ellipse Width="450" Height="450" Fill="#09FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-140,-100,0,0"/>
    <Ellipse Width="320" Height="320" Fill="#09FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-150,-80"/>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="24"><Image Source="Assets/AppIcon.png" Width="100" Height="100"/><TextBlock Text="GameShelf" FontSize="28" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center"/><TextBlock Text="游戏库" FontSize="16" Foreground="#CCFFFFFF" HorizontalAlignment="Center"/></StackPanel>
   </Grid>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
    <StackPanel Width="340" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20" Margin="24">
     <StackPanel x:Name="ConnectionFields" Spacing="20"><TextBlock Text="连接服务器" FontSize="26" FontWeight="SemiBold"/><TextBox x:Name="Address" AutomationProperties.AutomationId="Address" Header="服务器地址" PlaceholderText="https://server:8443" MinHeight="44"/><Button x:Name="ConnectButton" AutomationProperties.AutomationId="ConnectButton" Content="连接" HorizontalAlignment="Stretch" Click="ConnectClick" Style="{StaticResource AccentButtonStyle}"/></StackPanel>
     <StackPanel x:Name="CredentialsFields" Visibility="Collapsed" Spacing="20"><TextBlock Text="登录" FontSize="26" FontWeight="SemiBold"/><TextBox x:Name="Username" AutomationProperties.AutomationId="Username" Header="账号" MinHeight="44"/><PasswordBox x:Name="Password" AutomationProperties.AutomationId="Password" Header="密码" MinHeight="44"/><CheckBox x:Name="Remember" Content="保持登录" IsChecked="True"/><Button x:Name="LoginButton" AutomationProperties.AutomationId="LoginButton" Content="登录" HorizontalAlignment="Stretch" Click="LoginClick" Style="{StaticResource AccentButtonStyle}"/><Button Content="更改服务器" Click="ChangeServerClick"/></StackPanel>
     <Button Content="本地使用" AutomationProperties.AutomationId="LocalUseButton" Click="LocalUseClick"/>
     <TextBlock x:Name="LoginError" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid x:Name="LibraryPanel" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Grid Background="#EFEFEF" Padding="12"><Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><Image Source="Assets/AppIcon.png" Width="28" Height="28"/><TextBlock Text="游戏库" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
    <NavigationView x:Name="SidebarNavigation" Grid.Row="1" Grid.RowSpan="3" Height="128" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="216" IsPaneToggleButtonVisible="False" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" SelectionChanged="NavigationChanged">
     <NavigationView.MenuItems><NavigationViewItem x:Name="NavAll" Content="所有游戏" Tag="all"><NavigationViewItem.Icon><SymbolIcon Symbol="AllApps"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="NavRecent" Content="最近游玩" Tag="recent"><NavigationViewItem.Icon><SymbolIcon Symbol="Clock"/></NavigationViewItem.Icon></NavigationViewItem><NavigationViewItem x:Name="NavFavorite" Content="收藏" Tag="favorite"><NavigationViewItem.Icon><SymbolIcon Symbol="Favorite"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.MenuItems>
    </NavigationView>
    <Grid Grid.Row="4" Margin="0,18,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="分类" Margin="10,0" VerticalAlignment="Center"/><Button Content="+" Click="CreateCollectionClick" HorizontalAlignment="Right" AutomationProperties.Name="新建分类"/></Grid><TreeView Grid.Row="1" x:Name="Categories" AutomationProperties.AutomationId="Categories" SelectionMode="Single" ItemInvoked="CategoryInvoked"/></Grid>
    <Button Grid.Row="5" Content="设置" Click="SettingsClick" HorizontalAlignment="Stretch"/>
   </Grid>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="1"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Padding="22,12" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Heading" Text="所有游戏" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/><AutoSuggestBox x:Name="Search" Grid.Column="1" PlaceholderText="搜索游戏" TextChanged="SearchChanged" VerticalAlignment="Center"/><Button x:Name="ScanButton" Grid.Column="2" Content="扫描游戏" Click="ScanClick" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
    <GridView x:Name="Covers" AutomationProperties.AutomationId="Covers" Grid.Row="2" SizeChanged="GridSizeChanged" SelectionMode="Single" IsItemClickEnabled="False" ItemClick="GameInvoked" Padding="24" HorizontalContentAlignment="Stretch">
     <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal"/></ItemsPanelTemplate></GridView.ItemsPanel>
     <GridView.ItemContainerStyle><Style TargetType="GridViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></GridView.ItemContainerStyle>
     <GridView.ItemTemplate><DataTemplate x:DataType="local:LibraryCard"><StackPanel Width="{x:Bind Width,Mode=OneWay}" Spacing="8" Margin="6,6,6,20"><Border Height="{x:Bind CoverHeight,Mode=OneWay}" CornerRadius="6"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E8EDF5" Offset="0"/><GradientStop Color="#D3DDEA" Offset="1"/></LinearGradientBrush></Border.Background><Grid><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="3" FontSize="22" FontWeight="SemiBold" Foreground="#50627C" TextAlignment="Center" VerticalAlignment="Center" Margin="20"/><Image Tag="{x:Bind Id}" Loaded="CoverLoaded" DataContextChanged="CoverContextChanged" Tapped="CoverTapped" Stretch="Uniform"/></Grid></Border><Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><Button Grid.Column="1" Content="⋯" Tag="{x:Bind Id}" Click="PropertiesClick" Padding="6,0"/></Grid><Grid><TextBlock Text="{x:Bind TimeLabel}" FontSize="12" VerticalAlignment="Center"/><Button Content="启动" Tag="{x:Bind Id}" Click="PlayClick" HorizontalAlignment="Right"/></Grid></StackPanel></DataTemplate></GridView.ItemTemplate>
    </GridView>
    <Grid Grid.Row="3" Padding="22,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Status" TextWrapping="Wrap"/><Button Grid.Column="1" x:Name="StopButton" Content="停止" Visibility="Collapsed" Click="StopClick"/></Grid>
   </Grid>
  </Grid>
 </Grid>
</Window>
